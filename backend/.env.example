# Configuration NOIA_SGM

# API OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Configuration serveur
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS (origines autorisées, séparées par des virgules)
# En production, remplacer par votre nom de domaine
CORS_ORIGINS=["http://localhost:3000","https://votre-domaine.fr"]

# Sécurité (optionnel)
# API_KEY_HEADER=X-API-Key
# ALLOWED_API_KEYS=["key1","key2"]

# Paramètres OpenAI
MAX_TOKENS=2000
TEMPERATURE=0.3
